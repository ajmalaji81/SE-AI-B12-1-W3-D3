    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let data = item.json;\n\n  try {\n    // If the AI output is a string, parse it\n    if (typeof data === \"string\") {\n      data = JSON.parse(data);\n    }\n\n    // If stored inside a field like output/text/result\n    if (typeof data.output === \"string\") {\n      data = JSON.parse(data.output);\n    }\n\n    if (typeof data.text === \"string\") {\n      data = JSON.parse(data.text);\n    }\n\n    if (typeof data.result === \"string\") {\n      data = JSON.parse(data.result);\n    }\n\n    // Clean values\n    data.Student_ID = (data.Student_ID || \"\").trim();\n    data.Name = (data.Name || \"\").trim();\n    data.Email = (data.Email || \"\").trim().toLowerCase();\n    data.Phone = (data.Phone || \"\").replace(/\\D/g, \"\");\n    data.Course = (data.Course || \"\").trim();\n    data.City = (data.City || \"\").trim();\n\n    // Validate email\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    data.Email_Valid = emailRegex.test(data.Email);\n\n    return {\n      json: data\n    };\n\n  } catch (error) {\n    return {\n      json: {\n        error: \"Invalid JSON\",\n        raw: item.json\n      }\n    };\n  }\n});"
      },
